rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Compliance log: create-only, never updated or deleted by anyone,
    // including from the client SDK. Only the /api/consent server
    // route (using these same client SDK calls from a trusted server
    // context) should write here in this demo; lock it down further
    // with the Admin SDK + App Check before going to production.
    match /consentLogs/{entry} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    match /balanceAdjustments/{entry} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }

    match /simUsers/{userId} {
      allow read, write: if true; // simulation only — restrict before real deployment
    }

    match /spinLogs/{entry} {
      allow read: if false;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
